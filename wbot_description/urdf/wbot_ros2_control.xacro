<?xml version="1.0"?>

<robot name="wbot" xmlns:xacro="http://ros.org/wiki/xacro">
    <ros2_control name="RobotSystem" type="system">
        <!-- If using Gazebo Classic 11  -->
        <xacro:if value="$(arg is_classic)">
            <hardware>
            <plugin>gazebo_ros2_control/GazeboSimSystem</plugin>
            </hardware>
        </xacro:if>

        <!-- Otherwise, using Gazebo Sim / Ignition -->
        <xacro:unless value="$(arg is_classic)">
            <hardware>
            <plugin>gz_ros2_control/GazeboSystem</plugin>
            </hardware>
        </xacro:unless>
   
        <joint name="wheel_right_joint">
            <!-- how to send command to the hardware -->
            <command_interface name = "velocity">
                <param name="min" value="-1"/>
                <param name="max" value="1"/>
            </command_interface>
            <!-- how to receive feedback from motors -->
            <state_interface name = "position"/>
            <state_interface name = "velocity"/>
        </joint>

        <joint name="wheel_left_joint">
            <!-- how to send command to the hardware -->
            <command_interface name = "velocity">
                <param name="min" value="-1"/>
                <param name="max" value="1"/>  
            </command_interface>
            <!-- how to receive feedback from motors -->
            <state_interface name = "position"/>
            <state_interface name = "velocity"/>
        </joint>

    </ros2_control>

</robot>